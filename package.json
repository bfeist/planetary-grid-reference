{
  "name": "@bfeist/planetary-grid-reference",
  "version": "0.1.0-beta.1",
  "description": "Browser-oriented TypeScript port of selected LGRS coordinate features, with Earth analog grids.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bfeist/planetary-grid-reference.git"
  },
  "homepage": "https://github.com/bfeist/planetary-grid-reference#readme",
  "bugs": {
    "url": "https://github.com/bfeist/planetary-grid-reference/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./moon": {
      "types": "./dist/moon.d.ts",
      "import": "./dist/moon.js"
    },
    "./analogs": {
      "types": "./dist/analogs.d.ts",
      "import": "./dist/analogs.js"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "import": "./dist/grid.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check src tests bench scripts examples *.json *.ts README.md docs .github",
    "format": "prettier --write src tests bench scripts examples *.json *.ts README.md docs .github",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:browser && npm run test:package",
    "prepack": "npm run build",
    "lgrs:reference-corpus": "uv run --project scripts/lgrs-reference generate",
    "lgrs:reference-corpus-earth": "uv run --project scripts/lgrs-reference earth"
  },
  "dependencies": {
    "proj4": "2.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "geotiff": "2.1.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "keywords": [
    "lgrs",
    "moon",
    "lunar",
    "acc",
    "planetary",
    "grid",
    "browser",
    "typescript",
    "analog"
  ]
}
